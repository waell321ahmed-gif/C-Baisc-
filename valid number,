using System;

public class Program
{
    public static void Main()
    {
        Console.WriteLine("Enter a number between 1 and 10:");
        int number = int.Parse(Console.ReadLine());

        if (number >= 1 && number <= 10)
        {
            Console.WriteLine("Valid");
        }
        else
        {
            Console.WriteLine("Invalid");
        }
    }
}
