using System;

class Program
{
    static void Main()
    {
        int[,] theater = {
            { 1, 1, 1, 1 },
            { 1, 0, 1, 1 },
            { 1, 1, 0, 1 },
            { 1, 1, 1, 1 }
        };

        int totalSeats = 16;
        int bookedCount = 2; // بدأنا بـ 2 لأن المصفوفة فيها صفرين أصلاً

        while (bookedCount < totalSeats)
        {
            Console.Write("Enter row (0-3): ");
            int row = int.Parse(Console.ReadLine());

            Console.Write("Enter column (0-3): ");
            int col = int.Parse(Console.ReadLine());

            if (row >= 0 && row <= 3 && col >= 0 && col <= 3)
            {
                if (theater[row, col] == 1)
                {
                    theater[row, col] = 0;
                    bookedCount++;
                    Console.WriteLine("Success! Seat booked.");
                }
                else
                {
                    Console.WriteLine("This seat is already taken. Please pick another row and column.");
                }
            }
            else
            {
                Console.WriteLine("Invalid range! Please enter 0 to 3.");
            }

            Console.WriteLine($"Booked seats: {bookedCount}/{totalSeats}");
            Console.WriteLine();
        }

        Console.WriteLine("All seats are booked! The theater is full.");
    }
}
